<script>
$(function () {
    function postModeration(action, payload) {
        payload.hash_id = $('#chismy-moderation-rule-form [name="hash_id"]').val();
        $.post(Wo_Ajax_Requests_File() + '?f=admin_setting&s=' + action, payload, function (data) {
            var ok = data && data.status === 200;
            $('#chismy-moderation-alert').html('<div class="alert alert-' + (ok ? 'success' : 'danger') + '">' + (ok ? 'Guardado.' : (data.message || 'No se pudo guardar.')) + '</div>');
            if (ok) { setTimeout(function () { location.reload(); }, 500); }
        }, 'json');
    }
    $('#chismy-moderation-rule-form').on('submit', function (event) {
        event.preventDefault();
        postModeration('save_chismy_moderation_rule', {phrase: $(this).find('[name="phrase"]').val(), locale: $(this).find('[name="locale"]').val(), reason: $(this).find('[name="reason"]').val()});
    });
    $('.js-chismy-toggle-rule').on('click', function () { postModeration('toggle_chismy_moderation_rule', {id: this.dataset.id, enabled: this.dataset.enabled}); });
    $('.js-chismy-clear-user').on('click', function () { postModeration('clear_chismy_moderation_user', {user_id: this.dataset.id}); });
    $('#chismy-nsfw-settings-form').on('submit', function (event) {
        event.preventDefault();
        var payload = {hash_id: $('#chismy-moderation-rule-form [name="hash_id"]').val()};
        $(this).serializeArray().forEach(function (field) { payload[field.name] = field.value; });
        if (!payload.nsfw_precheck_enabled) { payload.nsfw_precheck_enabled = 'off'; }
        postModeration('save_nsfw_settings', payload);
    });
    $('.js-nsfw-approve').on('click', function () { postModeration('nsfw_media_action', {id: this.dataset.id, status: 'approved'}); });
    $('.js-nsfw-block').on('click', function () { postModeration('nsfw_media_action', {id: this.dataset.id, status: 'blocked'}); });
});
</script>
