FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY python/moderation-svc/requirements.txt ./
# Núcleo ligero primero; lo pesado (opencv/mediapipe/easyocr) es opcional.
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" numpy pydantic
COPY python/moderation-svc ./python/moderation-svc
EXPOSE 8001
CMD ["uvicorn", "python.moderation-svc.app.main:app", "--host", "0.0.0.0", "--port", "8001"]
