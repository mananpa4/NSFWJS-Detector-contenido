# Copiar a .env y ajustar. Ningun secreto real se commitea.
NODE_ENV=development
PORT=3000

# --- Seleccion de implementaciones (pensado para vibecoding: el agente elige) ---
# store: memory | sqlite | postgres
STORE=memory
# queue: memory | bullmq
QUEUE=memory
# image_provider: nsfwjs | hf-vit | py-svc
IMAGE_PROVIDER=nsfwjs
# text_filter: embedded | none  (embedded = port TS de Forbidden-Words)
TEXT_FILTER=embedded

# --- Microservicio Python (rostros + OCR + clasificacion pesada) ---
PY_SVC_URL=http://localhost:8001
PY_SVC_ENABLED=true

# --- Ollama VLM (2a opinion, solo zona gris) ---
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava:7b

# --- Umbrales (override opcional; por defecto los de src/config/thresholds.ts) ---
# TH_RISKY=0.35
# TH_BLOCK_PORN=0.5
# TH_REVIEW_MIN=0.20

# --- Persistencia pesada (solo si STORE/QUEUE las usan) ---
DATABASE_URL=postgres://moderacion:moderacion@localhost:5432/moderacion
REDIS_URL=redis://localhost:6379

# --- Lista de palabras prohibidas (coma o salto de linea; se suma a data/words.*) ---
# FORBIDDEN_EXTRA=casino,apuesta
# FORBIDDEN_REMOVED=
