{
  "name": "@moderacion/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de moderacion: decision, umbrales, filtro de texto, store y cola",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.0"
  }
}
